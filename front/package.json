{
  "description": "Interface d'administration du noeud RUDI",
  "name": "rudi-prodmanager-front",
  "version": "2.3.1",
  "author": "Yann Porret <yporret@micropole.com>, Olivier Martineau <olivier.martineau@irisa.fr>",
  "license": "EUPL-1.2",
  "private": true,
  "scripts": {
    "prestart": "npm run install:dev",
    "install:dev": "NODE_ENV=development npm i --loglevel=error",
    "start": "react-scripts start",
    "build": "npm run build:prod",
    "build:dev": "export DISABLE_ESLINT_PLUGIN=true INLINE_RUNTIME_CHUNK=false NODE_ENV=development react-scripts build",
    "build:prod": "DISABLE_ESLINT_PLUGIN=true INLINE_RUNTIME_CHUNK=false NODE_ENV=production react-scripts build",
    "build:windows": "Set DISABLE_ESLINT_PLUGIN=true & Set INLINE_RUNTIME_CHUNK=false & react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src/**.js",
    "cleanup": "rm -fR ./node_modules; rm -fR ./package-lock.json; rm -fR ./yarn.lock"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.24.3",
    "@svgr/webpack": "^8.1.0",
    "@textea/json-viewer": "3.4.0",
    "axios": "^1.6.8",
    "bootstrap": "^5.3.3",
    "history": "^5.3.0",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "jspreadsheet-ce": "^4.13.4",
    "nth-check": "^2.1.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.2",
    "react-bootstrap-icons": "^1.11.3",
    "react-dom": "^18.2.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-router": "^6.22.3",
    "react-router-dom": "^6.22.3",
    "react-scripts": "^5.0.1",
    "sass": "^1.72.0",
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.1",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.24.3",
    "@babel/preset-react": "^7.24.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.5.2",
    "eslint": "^8.57.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.34.1",
    "postcss": "^8.4.38"
  },
  "overrides": {
    "@svgr/webpack": "$@svgr/webpack",
    "nth-check": "$nth-check",
    "postcss": "$postcss"
  }
}
