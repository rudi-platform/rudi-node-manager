{
  "name": "rudi-prodmanager-back",
  "version": "1.0.0",
  "description": "Application d'administration du noeud RUDI",
  "main": "server.js",
  "scripts": {
    "prestart": "npm install && cd 1-sub/jwti && npm run prestart && npm run build",
    "test": "jest --config ./jest.config.json --coverage",
    "testCI": "jest --ci --reporters=default --reporters=jest-junit",
    "front": "cd front && npm start",
    "startProd": "Set NODE_ENV=production&node server",
    "serverWindow": "nodemon server.js --ignore './front/*' --exec \"Set RUDI_PROD_MANAGER_GIT_REV=git rev-parse --short HEAD& node\"",
    "serverLinux": "nodemon server.js --ignore './front/*' --exec \"export RUDI_PROD_MANAGER_GIT_REV=$(git rev-parse --short HEAD) ; node \"",
    "dev": "concurrently --kill-others-on-fail \"npm run front\" \"npm run serverWindow\"",
    "jwti-build": "cd 1-sub/jwti && ls && git pull origin main && npm i && npm run prestart && npm run build",
    "front-build": "cd front && npm run build",
    "lintBack": "eslint \"**/*.js\"",
    "lintFront": "eslint ./front/src/**/*.js -c front/.eslintrc --no-ignore",
    "prettier": "npx prettier --write .",
    "quality": "npm run prettier && npm run lintBack -- --fix",
    "stats": "find . -name \"node_modules\" -type d -prune | xargs du -chs",
    "cleanup": "rm -fR ./node_modules &; rm -fR ./front/node_modules &; rm -fR **/package-lock.json 2> /dev/null; rm -fR **/yarn.lock 2> /dev/null",
    "syncSub": "cd 1-sub/*; git pull"
  },
  "author": "Yann Porret <yporret@micropole.com>",
  "license": "EUPL-1.2",
  "dependencies": {
    "@aqmo.org/rudi_logger": "^1.1.2",
    "@babel/preset-react": "^7.18.6",
    "axios": "^0.27.2",
    "bcrypt": "^5.0.1",
    "bluebird": "^3.7.2",
    "body-parser": "^1.20.0",
    "concurrently": "^7.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "helmet": "^6.0.0",
    "ini": "^3.0.1",
    "jsonwebtoken": "^8.5.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "sqlite3": "^5.0.11",
    "sshpk": "^1.17.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.0",
    "@babel/eslint-parser": "^7.18.9",
    "@babel/preset-env": "^7.19.0",
    "eslint": "^8.23.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-only-warn": "^1.0.3",
    "jest": "^29.0.2",
    "jest-express": "^1.12.0",
    "jest-junit": "^14.0.1",
    "nodemon": "^2.0.20",
    "prettier": "^2.7.1"
  }
}
