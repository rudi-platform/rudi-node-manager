{
  "name": "rudi-console-proxy",
  "version": "1.0.0",
  "description": "application d'administration du noeud RUDI",
  "main": "server.js",
  "scripts": {
    "test": "jest --config ./jest.config.json --coverage",
    "testCI": "jest --ci --reporters=default --reporters=jest-junit",
    "front": "cd front && npm start",
    "startProd": "Set NODE_ENV=production&node server",
    "server": "nodemon server.js",
    "dev": "concurrently --kill-others-on-fail \"npm run front\" \"npm run server\"",
    "front:build": "cd front && npm run build",
    "lint": "eslint \"**/*.js\"",
    "prettier": "npx prettier --write ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^0.21.1",
    "bcrypt": "^5.0.1",
    "bluebird": "^3.7.2",
    "body-parser": "^1.19.0",
    "concurrently": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "ini": "^1.3.8",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.29.1",
    "nodemon": "^2.0.7",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "sqlite3": "^5.0.2"
  },
  "devDependencies": {
    "eslint": "^7.22.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-only-warn": "^1.0.2",
    "jest": "26.6.0",
    "jest-express": "^1.12.0",
    "jest-junit": "^12.0.0",
    "prettier": "^2.3.0"
  }
}
